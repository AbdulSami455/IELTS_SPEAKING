# Local template only. Copy to .env and fill secrets there.
# Never commit .env or production keys.

APP_ENV=development
WEB_ORIGIN=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=4000
VITE_API_BASE_URL=http://localhost:4000/v1

AUTH_MODE=dev
DEV_AUTH_USER_ID=00000000-0000-4000-8000-000000000001
AUTH_TOKEN_SECRET=development-jwt-secret-please-change-32
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=

DATABASE_URL=postgresql://ielts:ielts@localhost:5432/ielts
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_CANDIDATE_BUCKET=ielts-candidate-private
MINIO_DERIVATIVE_BUCKET=ielts-derived-private
MINIO_EXAMINER_BUCKET=ielts-examiner-private
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio-development-only
MINIO_FORCE_PATH_STYLE=true
MINIO_SIGNED_URL_TTL_SECONDS=900

INFERENCE_MODE=openrouter
OPENROUTER_API_KEY=
DEFAULT_MODEL=poolside/laguna-s-2.1:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_STT_MODEL=qwen/qwen3-asr-0.6b
OPENROUTER_STT_FALLBACK_MODEL=openai/whisper-tiny
OPENROUTER_TTS_MODEL=deepgram/flux-tts:free
OPENROUTER_TTS_VOICE=alloy
OPENROUTER_SCORING_MODEL=google/gemma-3-27b-it
OPENROUTER_SCORING_FALLBACK_MODEL=google/gemma-3-12b-it:free
OPENROUTER_PRONUNCIATION_MODEL=google/gemma-3-12b-it:free

REALTIME_TRANSPORT=websocket
REALTIME_LLM_MODEL=google/gemma-3-12b-it:free
REALTIME_STT_MODEL=nvidia/nemotron-3.5-asr-streaming-multilingual-0.6b
REALTIME_TTS_MODEL=deepgram/flux-tts:free
REALTIME_TTS_VOICE=flux-alexis-en

FREE_REQUEST_DAILY_HARD_LIMIT=1000
FREE_REQUEST_DAILY_SOFT_LIMIT=800
PAID_DAILY_BUDGET_USD=5.00
PAID_TEST_COST_CEILING_USD=0.035

RAW_AUDIO_RETENTION_DAYS=7
TRANSCRIPT_RETENTION_DAYS=30
REPORT_RETENTION_DAYS=365
UPLOAD_MAX_BYTES_PER_ANSWER=26214400
UPLOAD_MAX_BYTES_PER_TEST=104857600
LOG_LEVEL=info
