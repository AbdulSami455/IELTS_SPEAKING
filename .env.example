# Local template only. Copy to .env and fill secrets there.
# Never commit .env or production keys. See infra/deploy/railway.md for production values.

APP_ENV=development
WEB_ORIGIN=http://localhost:3000
# Extra browser origins allowed to call the API (comma-separated). Leave empty in production.
CORS_EXTRA_ORIGINS=
API_HOST=0.0.0.0
API_PORT=4000
VITE_API_BASE_URL=http://localhost:4000/v1
# Apply Alembic migrations on API start (dev only; production runs `alembic upgrade head` as a release step).
AUTO_MIGRATE=true

AUTH_MODE=jwt
AUTH_TOKEN_SECRET=development-jwt-secret-please-change-32
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
# Bump to force every learner to re-accept the terms, privacy policy, and recording consent.
CONSENT_VERSION=2026-10-12
# Bearer token that protects GET /metrics (required in production).
METRICS_TOKEN=
# Reverse-proxy hops in front of the API (Railway = 1) for client IP detection.
TRUSTED_PROXY_HOPS=0
TESTS_PER_DAY_LIMIT=10
# Optional Slack/Discord-compatible webhook for provider probe failures.
ALERT_WEBHOOK_URL=

DATABASE_URL=postgresql://ielts:ielts@localhost:5432/ielts
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_CANDIDATE_BUCKET=ielts-candidate-private
MINIO_DERIVATIVE_BUCKET=ielts-derived-private
MINIO_EXAMINER_BUCKET=ielts-examiner-private
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio-development-only
MINIO_FORCE_PATH_STYLE=true
MINIO_SIGNED_URL_TTL_SECONDS=900

# Inference: OpenRouter by default. Any OpenAI-compatible host works — see docs/models.md.
INFERENCE_MODE=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_STT_MODEL=qwen/qwen3-asr-0.6b
OPENROUTER_STT_FALLBACK_MODEL=openai/whisper-tiny
OPENROUTER_TTS_MODEL=deepgram/flux-tts:free
OPENROUTER_TTS_FALLBACK_MODEL=
OPENROUTER_TTS_VOICE=alloy
OPENROUTER_SCORING_MODEL=google/gemma-3-27b-it
OPENROUTER_SCORING_FALLBACK_MODEL=google/gemma-3-12b-it:free
OPENROUTER_PRONUNCIATION_MODEL=google/gemma-3-12b-it:free

REALTIME_TRANSPORT=websocket
# Examiner LLM. REALTIME_STT/TTS names are session labels; HTTP STT/TTS uses OPENROUTER_STT/TTS_*.
REALTIME_LLM_MODEL=google/gemma-3-12b-it:free
REALTIME_STT_MODEL=nvidia/nemotron-3.5-asr-streaming-multilingual-0.6b
REALTIME_TTS_MODEL=deepgram/flux-tts:free
REALTIME_TTS_VOICE=flux-alexis-en

FREE_REQUEST_DAILY_HARD_LIMIT=1000
FREE_REQUEST_DAILY_SOFT_LIMIT=800
PAID_DAILY_BUDGET_USD=5.00
PAID_TEST_COST_CEILING_USD=0.035

RAW_AUDIO_RETENTION_DAYS=7
TRANSCRIPT_RETENTION_DAYS=30
REPORT_RETENTION_DAYS=365
UPLOAD_MAX_BYTES_PER_ANSWER=26214400
UPLOAD_MAX_BYTES_PER_TEST=104857600
LOG_LEVEL=info

# Optional: Caddy overlay (docker-compose.caddy.yml)
# DOMAIN=speak.example.com
# ACME_EMAIL=you@example.com

# Production compose only (docker-compose.prod.yml): password for the bundled Postgres.
# POSTGRES_PASSWORD=

# Web build-time identity. Forks: set these so the app, footer, and legal pages name your organisation.
# (index.html keeps a static title and description; edit it for your own branding.)
# VITE_OPERATOR_NAME=Your Organisation
# VITE_PRODUCT_FULL_NAME=IELTS Speaking by Your Organisation
# VITE_SUPPORT_EMAIL=support@example.org
# VITE_LEGAL_UPDATED=1 January 2027
