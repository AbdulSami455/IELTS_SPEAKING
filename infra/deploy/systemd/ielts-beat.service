[Unit]
Description=IELTS speaking Celery beat
After=network.target redis.service
Requires=network.target

[Service]
Type=simple
User=ielts
Group=ielts
WorkingDirectory=/opt/ielts
EnvironmentFile=/etc/ielts/ielts.env
ExecStart=/opt/ielts/.venv/bin/celery -A ielts_worker.tasks:celery_app beat --loglevel=info --schedule /var/lib/ielts/celerybeat-schedule
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
