[Unit]
Description=IELTS speaking API
After=network.target postgresql.service redis.service
Requires=network.target

[Service]
Type=simple
User=ielts
Group=ielts
WorkingDirectory=/opt/ielts
EnvironmentFile=/etc/ielts/ielts.env
ExecStart=/opt/ielts/.venv/bin/uvicorn ielts_api.api:app --host 127.0.0.1 --port 4000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
